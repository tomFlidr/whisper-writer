<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows7.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<AssemblyName>WhisperWriter</AssemblyName>
		<RootNamespace>WhisperWriter</RootNamespace>
		<ApplicationIcon>app.ico</ApplicationIcon>
		<Version>1.4.0</Version>
		<AssemblyVersion>1.4.0.0</AssemblyVersion>
		<FileVersion>1.4.0.0</FileVersion>
		<!-- Strong name signing via .snk (no password required) -->
		<SignAssembly>true</SignAssembly>
		<AssemblyOriginatorKeyFile>WhisperWriter.snk</AssemblyOriginatorKeyFile>
		<DelaySign>false</DelaySign>
		<!-- Authenticode signing via signtool in post-build -->
		<PfxFile>$(MSBuildProjectDirectory)\WhisperWriter.pfx</PfxFile>
		<PfxPassword>1234</PfxPassword>
		<!-- Single-file publish: bundle all managed DLLs into WhisperWriter.exe -->
		<!-- Native DLLs (runtimes\) and Whisper models (llms\) must remain next to the exe -->
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>false</SelfContained>
		<IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
		<StartupObject>WhisperWriter.Program</StartupObject>
	</PropertyGroup>

	<!-- Copy Whisper models from llms to the output directory -->
	<ItemGroup>
		<Content Include="llms\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>

		<!-- Default settings – copied only if not already present in output -->
		<Content Include="settings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
		<!-- Model download helper scripts – copied next to the exe on build and publish -->
		<Content Include="download-models.ps1">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
		<Content Include="download-models.bat">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemGroup>
	<ItemGroup>
	  <Resource Include="app.ico" />
	  <Content Include="app.ico">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <None Include="..\AGENTS.md">
	    <Link>AGENTS.md</Link>
	  </None>
	  <None Include="../.github/workflows/release.yml">
	    <Link>.github/workflows/release.yml</Link>
	  </None>
	  <None Include="WhisperWriter.pfx" />
	  <None Include="WhisperWriter.snk" />
	</ItemGroup>

	<Target Name="AuthenticodeSigning" AfterTargets="Build">
		<PropertyGroup>
			<SignTool>C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\signtool.exe</SignTool>
			<OutputExe>$(OutputPath)$(AssemblyName).exe</OutputExe>
		</PropertyGroup>
		<Exec Command="&quot;$(SignTool)&quot; sign /f &quot;$(PfxFile)&quot; /p &quot;$(PfxPassword)&quot; /fd SHA256 /td SHA256 /tr http://timestamp.digicert.com &quot;$(OutputExe)&quot;" ContinueOnError="true" />
	</Target>

	<!-- Copy CUDA runtime DLLs into build and publish outputs when available. -->
	<!-- CudaBinDir is updated automatically by setup-dev.ps1 to match the locally installed CUDA version. -->
	<Target Name="CopyCudaRuntimeDllsToBuild" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' != 'win-x86' and '$(IsPublishing)' != 'true'">
		<PropertyGroup>
			<CudaBinDir>C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.2\bin\x64</CudaBinDir>
			<CudaVersion>$([System.Text.RegularExpressions.Regex]::Match($(CudaBinDir), 'v(\d+)\.').Groups[1].Value)</CudaVersion>
		</PropertyGroup>
		<ItemGroup>
			<CudaDll Include="$(CudaBinDir)\cublas64_$(CudaVersion).dll" />
			<CudaDll Include="$(CudaBinDir)\cublasLt64_$(CudaVersion).dll" />
			<CudaDll Include="$(CudaBinDir)\cudart64_$(CudaVersion).dll" />
		</ItemGroup>
		<Copy SourceFiles="@(CudaDll)" DestinationFolder="$(OutputPath)runtimes\cuda\win-x64" SkipUnchangedFiles="true" ContinueOnError="true" />
	</Target>
	<Target Name="CopyCudaRuntimeDllsToPublish" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != 'win-x86'">
		<PropertyGroup>
			<CudaBinDir>C:\Program Files\NVIDIA GPU Computing Toolkit\CUDA\v13.2\bin\x64</CudaBinDir>
			<CudaVersion>$([System.Text.RegularExpressions.Regex]::Match($(CudaBinDir), 'v(\d+)\.').Groups[1].Value)</CudaVersion>
		</PropertyGroup>
		<ItemGroup>
			<CudaDll Include="$(CudaBinDir)\cublas64_$(CudaVersion).dll" />
			<CudaDll Include="$(CudaBinDir)\cublasLt64_$(CudaVersion).dll" />
			<CudaDll Include="$(CudaBinDir)\cudart64_$(CudaVersion).dll" />
		</ItemGroup>
		<Copy SourceFiles="@(CudaDll)" DestinationFolder="$(PublishDir)runtimes\cuda\win-x64" SkipUnchangedFiles="true" ContinueOnError="true" />
	</Target>
	<ItemGroup>
		<ProjectReference Include="..\WhisperWriter.OrtRuntime.Contracts\WhisperWriter.OrtRuntime.Contracts.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Whisper inference via whisper.cpp bindings -->
		<PackageReference Include="Autofac" Version="9.1.0" />
		<PackageReference Include="Serilog" Version="4.3.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
		<PackageReference Include="Whisper.net" Version="1.9.0" />
		<PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />
		<!-- Native GPU runtime packages are x64-only; keep the win-x86 artifact CPU-only. -->
		<PackageReference Include="Whisper.net.Runtime.Cuda" Version="1.9.0" Condition="'$(RuntimeIdentifier)' != 'win-x86'" />
		<PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.0" Condition="'$(RuntimeIdentifier)' != 'win-x86'" />
		<!-- Audio capture -->
		<PackageReference Include="NAudio" Version="2.2.1" />
		<!-- SQLite for ETA statistics -->
		<PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
		<!-- Windows hardware discovery for environment fingerprinting -->
		<PackageReference Include="System.Management" Version="8.0.0" />
		<!-- System.Text.Json: no explicit pin – version is driven by Whisper.net transitive dependency -->
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Models\AppSettings.cs">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Compile>
	  <Compile Update="Services\Persistence\TranscriptionHistory.cs">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Utils\Structs\" />
	</ItemGroup>

</Project>
